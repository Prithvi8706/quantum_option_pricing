# IBM Quantum Platform (IBM Cloud) credentials for ibm_validation.py
# Copy this file to `.env` (which is gitignored) and fill in your real values.
# Do NOT commit real keys.
#
# Channel: ibm_cloud
# Get these from https://cloud.ibm.com -> your Quantum service instance:
#   IBM_QUANTUM_TOKEN = the IBM Cloud API key
#   IBM_QUANTUM_CRN   = the instance CRN (starts with "crn:v1:...")
IBM_QUANTUM_TOKEN=your_ibm_cloud_api_key_here
IBM_QUANTUM_CRN=your_instance_crn_here
